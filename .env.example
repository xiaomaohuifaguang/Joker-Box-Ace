# ─── 应用 ───
APP_NAME=joker-box-ace
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# ─── Nacos ───
NACOS_ENABLED=true
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE_ID=
NACOS_GROUP_NAME=DEFAULT_GROUP
NACOS_USERNAME=nacos
NACOS_PASSWORD=
NACOS_SERVICE_NAME=
# 留空自动探测本机局域网 IP；容器/多网卡环境必须显式指定为外部可达 IP
NACOS_REGISTER_IP=

# ─── 登录鉴权 ───
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=
# 多机部署必须显式配置且所有实例保持一致！留空则每次启动随机生成（仅单机调试用）
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL=86400
